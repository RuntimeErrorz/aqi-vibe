# ============================================================
# AQI Vibe 多数据源环境变量配置模板
# - 本地开发：复制为 .env.local
# - 生产环境 (Cloudflare Workers)：通过 `wrangler secret put <KEY>` 配置
# - 所有第三方补充源均为按需即插即用：配置哪个即自动激活参与策略 A 智能切源
# ============================================================

# 1. WAQI (全球基础监测站与排行榜切片主源，支持逗号分隔多 Token 轮询)
NEXT_PUBLIC_WAQI_TOKEN=your_waqi_api_token_here
WAQI_TOKENS=token1,token2,token3

# 2. CartoDB 地图底图 Key
NEXT_PUBLIC_CARTO_KEY=your_carto_api_key_here

# 3. 和风天气 QWeather Air Quality API v1 (国内/港澳优先 + 全球高速备源，每月 50,000 次免费额度)
# 专属 API Host (在和风控制台 -> 设置中获取，如 https://abc123.re.qweatherapi.com)
QWEATHER_API_HOST=
# 推荐：Ed25519 JWT 自动动态签发（永不过期，支持 Cloudflare Workers 原生 Web Crypto）
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY=
# 兼容备选：静态 JWT 或 API Key
QWEATHER_JWT=
QWEATHER_API_KEY=

# 4. OpenAQ API v3 (免费 60 req/min，北美/台湾官方地面站主源 + 全球 72h 小时流备源)
# 注册获取免费 Key：https://explore.openaq.org/
OPENAQ_API_KEY=

# 注：Open-Meteo (ECMWF/CAMS 5 天预报 + 实时气象) 完全免费免 Key，已在 Worker 边缘自动启用。

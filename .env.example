# ============================================================
# AQI Vibe 多数据源环境变量配置模板
# - 本地开发：复制为 .env.local
# - 生产环境 (Cloudflare Workers)：通过 `wrangler secret put <KEY>` 配置
# - 所有第三方补充源均为按需即插即用：配置哪个即自动激活参与策略 A 智能切源
# ============================================================

# 1. WAQI (全球基础监测站与排行榜切片主源，支持逗号分隔多 Token 轮询)
NEXT_PUBLIC_WAQI_TOKEN=your_waqi_api_token_here
WAQI_TOKENS=token1,token2,token3

# 2. CartoDB 地图底图 Key
NEXT_PUBLIC_CARTO_KEY=your_carto_api_key_here

# 3. 和风天气 QWeather Air Quality API v1 (强烈推荐：解决国内 37+ 重点城市 2~3h 延迟)
# 专属 API Host (在和风控制台 -> 设置中获取，如 https://abc123.re.qweatherapi.com)
QWEATHER_API_HOST=
# 推荐：Ed25519 JWT 自动动态签发（永不过期，支持 Cloudflare Workers 原生 Web Crypto）
QWEATHER_DEVELOPER_ID=
QWEATHER_PROJECT_ID=
QWEATHER_CREDENTIAL_ID=
QWEATHER_PRIVATE_KEY=
# 兼容备选：静态 JWT 或 API Key
QWEATHER_JWT=
QWEATHER_API_KEY=

# 3.5 彩云天气 Caiyun API v2.6 (国内第一梯队备源：直连国控/省控 + 4项实时气象 + 5天AI空气质量预报)
# 注册获取免费 Token：https://dashboard.caiyunapp.com/
CAIYUN_API_TOKEN=

# 4. OpenAQ API v3 (强烈推荐：免费 60 req/min，欧美澳官方地面站高精替补，解决巴黎/伦敦/纽约/罗马/马德里滞后)
# 注册获取免费 Key：https://explore.openaq.org/
OPENAQ_API_KEY=

# 5. US EPA AirNow (北美官方直连，美国/加拿大延迟 <30 分钟)
# 注册获取免费 Key：https://docs.airnowapi.org/
AIRNOW_API_KEY=

# 6. 台湾环境部 MOENV (台湾地区 77 座官方站直连，彻底解决台北 4h 延迟)
# 注册获取免费 Key：https://data.moenv.gov.tw/
MOENV_API_KEY=

# 7. Google Air Quality API (全球 100+ 国家 500m 高精融合，每月 10,000 次免费额度)
GOOGLE_AQ_API_KEY=

# 8. OpenWeather Air Pollution API (全球 6 项污染物，免费 1,000 次/天)
OPENWEATHER_API_KEY=

# 注：香港环保署 EPD (hk-epd) 与 Open-Meteo ECMWF/CAMS 预报完全免费免 Key，已在 Worker 边缘自动启用。
